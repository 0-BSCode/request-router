# Local PostgreSQL connection. Use a dedicated database for this project.
DATABASE_URL=postgres://user:pass@localhost:5432/request_router

# Public application origin; use your HTTPS domain when deployed.
BETTER_AUTH_URL=http://localhost:3000
# Replace with a random secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Sole account, created automatically on first startup. Keep the email stable.
OWNER_EMAIL=
# Initial password, 8 to 128 characters. Changes do not reset an existing account.
OWNER_PASSWORD=

# Server-only routing configuration. Choose a general-purpose model supporting structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Set any nonempty sandbox secret for the local mock APIs; never expose it to the browser.
MOCK_API_KEY=
